  npcs:
  - id: 1
    name: gatekeeper
    displayName: "L\xE3o Th\u1EA1ch"
    role: "Canh c\u1ED5ng"
    greeting: "L\u1EA1i l\xE0 ng\u01B0\u01A1i. C\xF3 vi\u1EC7c g\xEC th\xEC n\xF3i
      nhanh, ta c\xF2n ph\u1EA3i canh c\u1ED5ng."
    greetingStranger: "\u0110\u1EE9ng l\u1EA1i! M\u1EB7t l\u1EA1 ho\u1EAFc. Ng\u01B0\u01A1i
      l\xE0 ai, t\u1EDBi l\xE0ng V\xE2n Kh\xEA l\xE0m g\xEC?"
    greetingTrusted: "\xC0, ng\u01B0\u01A1i \u0111\u1EA5y \xE0. C\xF3 ng\u01B0\u01A1i
      quanh \u0111\xE2y ta y\xEAn t\xE2m h\u01A1n nhi\u1EC1u."
    greetingDisliked: "Ta \u0111\u1EC3 m\u1EAFt t\u1EDBi ng\u01B0\u01A1i \u0111\u1EA5y.
      \u0110\u1EEBng g\xE2y chuy\u1EC7n trong l\xE0ng."
    refuseLine: "Ta ch\u01B0a bi\u1EBFt ng\u01B0\u01A1i \u0111\u1EE7 \u0111\u1EC3
      giao vi\u1EC7c h\u1EC7 tr\u1ECDng. L\xE0m t\u1ED1t nh\u1EEFng vi\u1EC7c nh\u1ECF
      tr\u01B0\u1EDBc \u0111\xE3."
    shunLine: "L\xE3o Th\u1EA1ch ch\u1EB7n c\xE2y gi\xE1o ngang c\u1ED5ng, kh\xF4ng
      th\xE8m nh\xECn ng\u01B0\u01A1i."
    options:
    - name: ask_village
      label: "H\u1ECFi v\u1EC1 l\xE0ng"
      action: 0
      pages:
      - "V\xE2n Kh\xEA l\xE0 l\xE0ng cu\u1ED1i c\xF9ng tr\u01B0\u1EDBc R\u1EEBng
        S\u01B0\u01A1ng. Qua r\u1EEBng l\xE0 n\xFAi Linh S\u01A1n."
      - "Ba m\u01B0\u01A1i n\u0103m ta \u0111\u1EE9ng \u1EDF c\u1ED5ng n\xE0y, ch\u01B0a
        n\u0103m n\xE0o qu\xE1i nhi\u1EC1u nh\u01B0 n\u0103m nay."
      - "Trong l\xE0ng c\xF3 th\u1EE3 r\xE8n, th\u1EA7y thu\u1ED1c, th\u1EA7y \u0111\u1ED3
        v\xE0 m\u1ED9t b\xE0 th\u1EA7y b\xF3i. Ai c\u0169ng c\xF3 vi\u1EC7c c\u1EA7n
        ng\u01B0\u1EDDi gi\xFAp."
      price: 0
      item: 
      param: 0
      choices:
      - name: kind
        label: "Ba m\u01B0\u01A1i n\u0103m... l\xE3o v\u1EA5t v\u1EA3 r\u1ED3i."
        condition:
          requiresFlag: 
          forbidsFlag: 
          tierNpc: 
          minTier: 0
          minAllies: 0
          allyTier: 3
          item: 
          itemCount: 1
        reply:
        - "H\u1EEB... c\u0169ng l\xE2u l\u1EAFm m\u1EDBi c\xF3 k\u1EBB n\xF3i c\xE2u
          \u0111\xF3."
        effects:
        - kind: 0
          target: gatekeeper
          amount: 3
        flag: talk_gate
      - name: rude
        label: "Canh c\u1ED5ng th\xEC c\xF3 g\xEC m\xE0 kh\xF3."
        condition:
          requiresFlag: 
          forbidsFlag: 
          tierNpc: 
          minTier: 0
          minAllies: 0
          allyTier: 3
          item: 
          itemCount: 1
        reply:
        - "Ng\u01B0\u01A1i th\u1EED \u0111\u1EE9ng \u0111\xE2y m\u1ED9t \u0111\xEAm
          c\xF3 qu\xE1i r\u1ED3i h\xE3y n\xF3i."
        effects:
        - kind: 0
          target: gatekeeper
          amount: -5
        flag: talk_gate
