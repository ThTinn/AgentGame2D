  quests:
  - id: 1
    name: main_01_arrival
    title: "Ng\u01B0\u1EDDi l\u1EA1 tr\u01B0\u1EDBc c\u1ED5ng"
    category: 0
    chapter: 1
    giver: gatekeeper
    turnIn: healer
    minTier: 0
    requires: 
    repeatable: 0
    condition:
      requiresFlag: 
      forbidsFlag: 
      tierNpc: 
      minTier: 0
      minAllies: 0
      allyTier: 3
      item: 
      itemCount: 1
    offer:
    - "\u0110\u1EE9ng l\u1EA1i! M\u1EB7t m\u0169i x\xE2y x\u01B0\u1EDBc th\u1EBF
      kia... ng\u01B0\u01A1i ng\xE3 t\u1EEB \u0111\xE2u xu\u1ED1ng v\u1EADy?"
    - "Th\xF4i \u0111\u01B0\u1EE3c. Ta kh\xF4ng \u0111\u1EC3 k\u1EBB b\u1ECB th\u01B0\u01A1ng
      \u0111\u1EE9ng ch\u1EAFn c\u1ED5ng. T\u1EDBi nh\xE0 thu\u1ED1c c\u1EE7a B\xE0
      Di\u1EC7p, b\xE0 \u1EA5y s\u1EBD xem cho."
    inProgress: "Nh\xE0 thu\u1ED1c c\u1EE7a B\xE0 Di\u1EC7p \u1EDF gi\u1EEFa l\xE0ng.
      \u0110i \u0111i, \u0111\u1EEBng \u0111\u1EC3 ta nh\u1EAFc l\u1EA7n hai."
    complete:
    - "L\xE3o Th\u1EA1ch g\u1EEDi con t\u1EDBi h\u1EA3? Ng\u1ED3i xu\u1ED1ng \u0111\xE2y
      b\xE0 xem n\xE0o."
    - "V\u1EBFt th\u01B0\u01A1ng kh\xF4ng s\xE2u, nh\u01B0ng d\xEDnh nh\u1EA7y Slime.
      Con \u0111i qua b\xE3i c\u1ECF ph\xEDa t\xE2y l\xE0ng ph\u1EA3i kh\xF4ng?"
    offerChoices: []
    turnInPrompt: 
    outcomes: []
    objectives: []
    gold: 50
    exp: 100
    item: potion_hp_small
    itemCount: 3
    bonusItem: 
    bonusTier: 3
    affinity:
    - npc: healer
      amount: 5
    - npc: gatekeeper
      amount: 3
  - id: 2
    name: main_02_slime_plague
    title: "D\u1ECBch nh\u1EA7y"
    category: 0
    chapter: 1
    giver: healer
    turnIn: 
    minTier: 0
    requires: main_01_arrival
    repeatable: 0
    condition:
      requiresFlag: 
      forbidsFlag: 
      tierNpc: 
      minTier: 0
      minAllies: 0
      allyTier: 3
      item: 
      itemCount: 1
    offer:
    - "M\u1EA5y th\xE1ng nay l\u0169 Slime xanh tr\xE0n t\u1EDBi s\xE1t l\xE0ng.
      Nh\u1EA7y c\u1EE7a ch\xFAng d\xEDnh v\xE0o ai l\xE0 ng\u01B0\u1EDDi \u0111\xF3
      ng\u1EE9a r\xE1t c\u1EA3 tu\u1EA7n."
    - "B\xE0 c\u1EA7n ng\u01B0\u1EDDi d\u1ECDn b\u1EDBt b\u1EA7y \u1EDF b\xE3i ph\xEDa
      t\xE2y l\xE0ng. Con gi\xFAp b\xE0 \u0111\u01B0\u1EE3c kh\xF4ng?"
    inProgress: "B\xE3i Slime \u1EDF ph\xEDa t\xE2y l\xE0ng. C\u1EA9n th\u1EADn \u0111\u1EEBng
      \u0111\u1EC3 nh\u1EA7y d\xEDnh v\xE0o m\u1EAFt."
    complete:
    - "Gi\u1ECFi l\u1EAFm con. Nh\u01B0ng b\xE0 th\u1EA5y l\u1EA1... Slime ch\u1EC9
      \u0111\xF4ng th\u1EBF n\xE0y khi \u0111\u1EA5t m\u1EA5t linh kh\xED."
    - "M\xE0 khoan, m\u1EA3nh ng\u1ECDc tr\xEAn c\u1ED5 con... con c\xF3 n\xF3 t\u1EEB
      \u0111\xE2u v\u1EADy?"
    offerChoices:
    - name: eager
      label: "C\u1EE9 giao cho con."
      condition:
        requiresFlag: 
        forbidsFlag: 
        tierNpc: 
        minTier: 0
        minAllies: 0
        allyTier: 3
        item: 
        itemCount: 1
      reply:
      - "Ngoan l\u1EAFm. Nh\u1EDB c\u1EA9n th\u1EADn \u0111\u1EA5y con."
      effects:
      - kind: 0
        target: healer
        amount: 3
      flag: story_healer_eager
    - name: pay
      label: "C\xF3 th\u01B0\u1EDFng th\xEC con l\xE0m."
      condition:
        requiresFlag: 
        forbidsFlag: 
        tierNpc: 
        minTier: 0
        minAllies: 0
        allyTier: 3
        item: 
        itemCount: 1
      reply:
      - "\u1EEA... b\xE0 c\u0169ng kh\xF4ng \u0111\u1EC3 con thi\u1EC7t \u0111\xE2u."
      effects:
      - kind: 0
        target: healer
        amount: -2
      flag: story_healer_eager
    turnInPrompt: 
    outcomes: []
    objectives:
    - kind: 0
      target: 1
      count: 5
      label: "H\u1EA1 Slime xanh"
      where:
        mapId: 0
        point: {x: -34, y: 6}
        radius: 9
      lines: []
